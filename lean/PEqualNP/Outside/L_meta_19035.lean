theorem allBits_bit (k : ℕ) (hk : k < 16384) : allBits.testBit k = true := by
  have h : allBits = 2 ^ 16384 - 1 := rfl
  rw [h, Nat.testBit_two_pow_sub_one]
  exact decide_eq_true hk

set_option maxRecDepth 12000 in
set_option maxHeartbeats 8000000 in
theorem rowMask_bit (k : ℕ) (hk : k < 128) : rowMask.testBit k = true := by
  have h : rowMask = 2 ^ 128 - 1 := by decide
  rw [h, Nat.testBit_two_pow_sub_one]
  exact decide_eq_true hk

set_option maxRecDepth 12000 in
set_option maxHeartbeats 8000000 in
theorem rowMask_bit_ge (k : ℕ) (hk : 128 ≤ k) : rowMask.testBit k = false := by
  have h : rowMask = 2 ^ 128 - 1 := by decide
  rw [h, Nat.testBit_two_pow_sub_one]
  exact decide_eq_false (by omega)

set_option maxRecDepth 12000 in
set_option maxHeartbeats 8000000 in
theorem colPat_bit (u : Fin 128) (v : Fin 128) (j : Fin 128) :
    (colPat <<< j.val).testBit (128 * u.val + v.val) = decide (j = v) := by
  rw [Nat.testBit_shiftLeft]
  by_cases hle : j.val ≤ 128 * u.val + v.val
  · simp only [decide_eq_true hle, Bool.true_and]
    have hmod : (128 * u.val + v.val - j.val) % 128 = (128 + v.val - j.val) % 128 := by omega
    have hlt : 128 * u.val + v.val - j.val < 16384 := by omega
    have hslice : ∀ q : Fin 128, (colPat >>> (128 * q.val)) &&& rowMask = 1 := by decide +kernel
    have hone : ∀ r : Fin 128, (1 : ℕ).testBit r.val = decide (r.val = 0) := by decide +kernel
    have hcp : ∀ k : Fin 16384, colPat.testBit k.val = decide (k.val % 128 = 0) := by
      intro k
      let q : Fin 128 := ⟨k.val / 128, by omega⟩
      let r : Fin 128 := ⟨k.val % 128, Nat.mod_lt _ (by decide)⟩
      have e := congrArg (fun z : ℕ => z.testBit r.val) (hslice q)
      change (((colPat >>> (128 * q.val)) &&& rowMask).testBit r.val) = (1 : ℕ).testBit r.val at e
      rw [Nat.testBit_and, rowMask_bit _ r.isLt, Bool.and_true, Nat.testBit_shiftRight, hone] at e
      have hi : 128 * q.val + r.val = k.val := by dsimp [q,r]; omega
      rw [hi] at e
      exact e
    rw [hcp ⟨128 * u.val + v.val - j.val, hlt⟩]
    apply Bool.eq_iff_iff.mpr
    simp only [decide_eq_true_eq]
    constructor
    · intro hm
      apply Fin.ext
      omega
    · rintro rfl
      omega
  · simp only [decide_eq_false hle, Bool.false_and]
    symm
    apply decide_eq_false
    intro heq
    subst heq
    omega

set_option maxRecDepth 12000 in
set_option maxHeartbeats 8000000 in
theorem shiftedRow_bit (i u v : Fin 128) :
    (rowMask <<< (128 * i.val)).testBit (128 * u.val + v.val) = decide (i = u) := by
  rw [Nat.testBit_shiftLeft]
  by_cases hle : 128 * i.val ≤ 128 * u.val + v.val
  · simp only [decide_eq_true hle, Bool.true_and]
    by_cases heq : i = u
    · subst heq
      have h1 : 128 * i.val + v.val - 128 * i.val = v.val := by omega
      rw [h1, rowMask_bit v.val v.isLt]
      simp
    · have hlt : i.val < u.val := by
        have hne : i.val ≠ u.val := fun h => heq (Fin.ext h)
        omega
      have hge : 128 ≤ 128 * u.val + v.val - 128 * i.val := by omega
      rw [rowMask_bit_ge _ hge]
      simp [heq]
  · simp only [decide_eq_false hle, Bool.false_and]
    symm
    apply decide_eq_false
    intro heq
    subst heq
    omega

