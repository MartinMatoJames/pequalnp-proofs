def hullRow (r : ℕ) : ℕ := if r < slots then rowAt r else if r = slots then 65535 else 0
def lookup (x : ℕ) := if x=0 then slots+1 else if x=65535 then slots else keyIndex x
def extend (r : ℕ) (j : V) := lookup (hullRow r &&& zeroRows j)

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
lemma extensions : ∀ r : Fin 1238, ∀ j : V,
    extend r.val j < 1238 ∧ hullRow (extend r.val j) = hullRow r.val &&& zeroRows j := by decide +kernel

lemma zero_rows_bit : ∀ i j : V, (zeroRows j).testBit i.val = !forbidden i j := by decide +kernel
lemma proper_col : ∀ j : V, 65535 &&& zeroRows j ≠ 65535 := by decide +kernel
set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
lemma closed_cols : ∀ r : Fin slots, ∀ j : V,
    rowAt r.val &&& zeroRows j = rowAt r.val → (colAt r.val).testBit j.val = true := by decide +kernel

def build : List V → ℕ
  | [] => slots
  | j::js => extend (build js) j
lemma build_bound (js : List V) : build js < 1238 := by
  induction js with
  | nil => decide
  | cons j js ih => exact (extensions ⟨build js,ih⟩ j).1
lemma build_cons (j : V) (js : List V) : hullRow (build (j::js)) = hullRow (build js) &&& zeroRows j :=
  (extensions ⟨build js,build_bound js⟩ j).2
lemma full_bit : ∀ i : V, (65535:ℕ).testBit i.val = true := by decide +kernel

lemma build_rows {js : List V} {i : V} (h : ∀ j ∈ js, forbidden i j = false) :
    (hullRow (build js)).testBit i.val = true := by
  induction js with
  | nil => exact full_bit i
  | cons j js ih =>
    rw [build_cons, Nat.testBit_and, ih (fun a ha => h a (by simp [ha])), zero_rows_bit, h j (by simp)]
    rfl

lemma build_cols {js : List V} {j : V} (hj : j ∈ js) :
    hullRow (build js) &&& zeroRows j = hullRow (build js) := by
  induction js with
  | nil => simp at hj
  | cons a js ih =>
    rw [build_cons]
    rcases List.mem_cons.mp hj with rfl|h
    · simp
    · rw [Nat.and_right_comm, ih h]

noncomputable def label (b : Box) : ℕ := if build b.2.toList < slots then build b.2.toList else 0
lemma label_bound (b : Box) : label b < slots := by
  unfold label; split <;> first | assumption | decide

def hit (r : ℕ) (i j : V) : Prop := (rowAt r).testBit i.val = true ∧ (colAt r).testBit j.val = true
def Geo (L : List ℕ) : Prop := ∀ i j : V, forbidden i j = false → ∃ r ∈ L, hit r i j

lemma label_hit {b : Box} {i j : V} (hi : i ∈ b.1) (hj : j ∈ b.2)
    (sound : ∀ u ∈ b.1, ∀ v ∈ b.2, forbidden u v = false) : hit (label b) i j := by
  let r := build b.2.toList
  have hr := build_bound b.2.toList
  have h1 : (hullRow r).testBit i.val = true := build_rows (fun v hv => sound i hi v (by simpa using hv))
  have h2 : hullRow r &&& zeroRows j = hullRow r := build_cols (by simpa using hj)
  have hlt : r < slots := by
    by_contra! hn
    have he : r = slots ∨ r = slots+1 := by change r < 1238 at hr; unfold slots at *; omega
    rcases he with he|he
    · rw [he] at h2
      exact proper_col j (by simpa [hullRow] using h2)
    · rw [he] at h1; simp [hullRow] at h1
  rw [hullRow, ite_eq_left hlt] at h1 h2
  have he : label b = r := ite_eq_left hlt
  rw [he]
  exact ⟨h1, closed_cols ⟨r,hlt⟩ j h2⟩

lemma ones_bit (r : Fin slots) : ones.testBit (24*r.val) = true := by
  rw [ones_eq]
  exact pk_bit (f := fun _ => 1) (by intros; decide) r.isLt (b := 0) (by decide)
lemma physical_bit (data : ℕ) (i : V) (r : Fin slots) :
    (physical data i.val).testBit (24*r.val) = (fieldAt data r.val).testBit i.val := by
  simp [physical, fieldAt, Nat.testBit_and, Nat.testBit_shiftRight, ones_bit r, full_bit i, Nat.add_comm]
lemma clean_cell (i j : V) : cell i.val j.val &&& ones = cell i.val j.val := by
  simp [cell, physical, Nat.and_assoc]

lemma clean_obligations : Clean obligations := by
  intro c hc
  obtain ⟨p,hp,rfl⟩ := List.mem_map.mp hc
  have hlt := List.mem_range.mp (List.mem_filter.mp hp).1
  exact clean_cell ⟨p/16,by omega⟩ ⟨p%16,by omega⟩

lemma geo_covers {L : List ℕ} (bounded : ∀ r ∈ L, r < slots) (h : Geo L) : Covers obligations L := by
  intro c hc
  obtain ⟨p,hp,rfl⟩ := List.mem_map.mp hc
  obtain ⟨hr,hz⟩ := List.mem_filter.mp hp
  have hlt := List.mem_range.mp hr
  let i : V := ⟨p/16,by omega⟩
  let j : V := ⟨p%16,by omega⟩
  obtain ⟨r,hm,h1,h2⟩ := h i j (by simpa [i,j] using hz)
  refine ⟨r,hm,?_⟩
  change (physical rowAtData i.val &&& physical colAtData j.val).testBit (24*r) = true
  rw [Nat.testBit_and, physical_bit rowAtData i ⟨r,bounded r hm⟩, physical_bit colAtData j ⟨r,bounded r hm⟩]
  exact Bool.and_eq_true_iff.mpr ⟨h1,h2⟩

-- Rotations, reflection, and transposition preserve covers and take each class to its representative.
abbrev Gen := Fin 3
def perm (g : Gen) (r : ℕ) := if g=0 then perm0 r else if g=1 then perm1 r else perm2 r
def back (g : Gen) (i : V) : V :=
  if g=0 then ⟨(i.val+15)%16, by omega⟩ else if g=1 then ⟨(16-i.val)%16, by omega⟩ else i

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
lemma perm_bounds : ∀ g : Gen, ∀ r : Fin slots, perm g r.val < slots ∧ rootOf (perm g r.val) = rootOf r.val := by decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
lemma transport_bits : ∀ g : Gen, ∀ r : Fin slots, ∀ i : V,
    (rowAt (perm g r.val)).testBit i.val =
      (if g=2 then colAt r.val else rowAt r.val).testBit (back g i).val ∧
    (colAt (perm g r.val)).testBit i.val =
      (if g=2 then rowAt r.val else colAt r.val).testBit (back g i).val := by decide +kernel

lemma transport_matrix : ∀ g : Gen, ∀ i j : V,
    forbidden (if g=2 then back g j else back g i) (if g=2 then back g i else back g j) = forbidden i j := by decide +kernel

def Bounded (L : List ℕ) := ∀ r ∈ L, r < slots
def Acts (f : ℕ → ℕ) : Prop :=
  (∀ r < slots, f r < slots ∧ rootOf (f r) = rootOf r) ∧
  ∀ L, Bounded L → Geo L → Geo (L.map f)

lemma perm_acts (g : Gen) : Acts (perm g) := by
  refine ⟨fun r hr => perm_bounds g ⟨r,hr⟩, ?_⟩
  intro L hb hg i j hz
  obtain ⟨r,hm,hitR,hitC⟩ := hg _ _ ((transport_matrix g i j).trans hz)
  refine ⟨_, List.mem_map_of_mem hm, ?_, ?_⟩
  · rw [(transport_bits g ⟨r,hb r hm⟩ i).1]
    by_cases e : g = 2
    · simpa [e] using hitC
    · simpa [e] using hitR
  · rw [(transport_bits g ⟨r,hb r hm⟩ j).2]
    by_cases e : g = 2
    · simpa [e] using hitR
    · simpa [e] using hitC

lemma acts_bounded {f : ℕ → ℕ} (h : Acts f) {L : List ℕ} (hb : Bounded L) : Bounded (L.map f) := by
  intro r hr
  obtain ⟨s,hs,rfl⟩ := List.mem_map.mp hr
  exact (h.1 s (hb s hs)).1

lemma acts_id : Acts (fun r => r) := ⟨fun _ h => ⟨h,rfl⟩, by simp⟩
lemma acts_comp {f g : ℕ → ℕ} (hf : Acts f) (hg : Acts g) : Acts (fun r => f (g r)) := by
  constructor
  · intro r hr
    obtain ⟨hb,he⟩ := hg.1 r hr
    obtain ⟨hv,hh⟩ := hf.1 _ hb
    exact ⟨hv,hh.trans he⟩
  · intro L hb hcov
    simpa only [List.map_map, Function.comp_def] using hf.2 _ (acts_bounded hg hb) (hg.2 _ hb hcov)

def rotations : ℕ → ℕ → ℕ
  | 0,r => r
  | n+1,r => perm 0 (rotations n r)
lemma rotations_act (n : ℕ) : Acts (rotations n) := by
  induction n with
  | zero => exact acts_id
  | succ n ih => exact acts_comp (f := perm 0) (g := rotations n) (perm_acts 0) ih

def optional (b : Bool) (g : Gen) (r : ℕ) := if b then perm g r else r
lemma optional_act (b : Bool) (g : Gen) : Acts (optional b g) := by
  cases b
  · exact acts_id
  · exact perm_acts g

def normalize (t r : ℕ) :=
  rotations (t%16) (optional (t.testBit 4) 1 (optional (t.testBit 5) 2 r))
lemma normalize_act (t : ℕ) : Acts (normalize t) :=
  acts_comp (f := rotations (t%16)) (g := fun r => optional (t.testBit 4) 1 (optional (t.testBit 5) 2 r))
    (rotations_act _) (acts_comp (f := optional (t.testBit 4) 1) (g := optional (t.testBit 5) 2)
      (optional_act _ _) (optional_act _ _))

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
lemma orbit_data : ∀ r : Fin slots,
    normalize (tagOf r.val) r.val = rootOf r.val ∧ rootOf r.val ≤ r.val ∧ rootOf r.val ∈ roots := by decide +kernel

lemma pool_allows {r j : ℕ} (hr : r ≤ j) (hj : j < slots) : Allowed (pool r) j := by
  refine ⟨hj, ?_⟩
  have ho : ones.testBit (24*j) = true := by
    rw [ones_eq]
    exact pk_bit (f := fun _ => 1) (by intros; decide) hj (b := 0) (by decide)
  simp [pool, Nat.testBit_shiftLeft, Nat.testBit_shiftRight, show 24*r ≤ 24*j+23 by omega, ho]

lemma leastLabel (f : ℕ → ℕ) {L : List ℕ} (h : L ≠ []) : ∃ r ∈ L, ∀ s ∈ L, f r ≤ f s := by
  induction L with
  | nil => contradiction
  | cons a xs ih =>
    by_cases hx : xs = []
    · subst xs; simp
    · obtain ⟨b,hb,hm⟩ := ih hx
      by_cases hab : f a ≤ f b
      · refine ⟨a, List.mem_cons_self, ?_⟩
        intro s hs; rcases List.mem_cons.mp hs with rfl|hs
        · exact le_rfl
        · exact hab.trans (hm s hs)
      · refine ⟨b, List.mem_cons_of_mem a hb, ?_⟩
        intro s hs; rcases List.mem_cons.mp hs with rfl|hs
        · omega
        · exact hm s hs

lemma root_witness {L : List ℕ} (len : L.length ≤ 9) (bounded : Bounded L) (geo : Geo L) :
    ∃ b ∈ roots, Possible (after obligations b) (pool b) 8 := by
  have hn : L ≠ [] := by
    obtain ⟨r,hr,_⟩ := geo 0 0 (by decide)
    intro e; simp [e] at hr
  obtain ⟨r,hr,least⟩ := leastLabel rootOf hn
  let f := normalize (tagOf r)
  have act : Acts f := normalize_act _
  obtain ⟨he,_,hroot⟩ := orbit_data ⟨r,bounded r hr⟩
  change f r = rootOf r at he
  have hb := acts_bounded act bounded
  have hh := geo_covers hb (act.2 _ bounded geo)
  have hmem : rootOf r ∈ L.map f := he ▸ List.mem_map_of_mem hr
  refine ⟨rootOf r,hroot,possible_take (k := 9) hmem (by simpa using len) ?_ hh⟩
  intro j hj
  obtain ⟨s,hs,rfl⟩ := List.mem_map.mp hj
  have h0 := act.1 s (bounded s hs)
  have h1 := (orbit_data ⟨f s,h0.1⟩).2.1
  exact pool_allows ((least s hs).trans (h0.2 ▸ h1)) h0.1

