import PEqualNP.Defs

namespace PEqualNP.Outside.L_meta_11098

-- The digit at position r records the gain of rectangle r. Each digit occupies 24 bits.
abbrev slots := 1236
abbrev guardValue := 8388608

def pk (n : ℕ) (f : ℕ → ℕ) : ℕ := ∑ j ∈ Finset.range n, f j * 2 ^ (24 * j)

lemma pk_succ (n : ℕ) (f : ℕ → ℕ) : pk (n + 1) f = 2 ^ (24 * n) * f n + pk n f := by
  rw [pk, Finset.sum_range_succ, ← pk]; ring

lemma pk_lt {n : ℕ} {f : ℕ → ℕ} (h : ∀ j < n, f j < 16777216) : pk n f < 2 ^ (24 * n) := by
  induction n with
  | zero => simp [pk]
  | succ n ih =>
    have h1 := ih (fun j hj => h j (by omega))
    have h2 := h n (by omega)
    rw [pk_succ, show 24 * (n + 1) = 24 * n + 24 by ring, pow_add]
    have h3 : 2 ^ (24 * n) * f n ≤ 2 ^ (24 * n) * 16777215 := Nat.mul_le_mul_left _ (by omega)
    change 2 ^ (24*n) * f n + pk n f < 2^(24*n) * 16777216
    omega

lemma pk_add (n : ℕ) (f g : ℕ → ℕ) : pk n f + pk n g = pk n (fun j => f j + g j) := by
  simp [pk, ← Finset.sum_add_distrib, add_mul]

lemma pk_smul (n c : ℕ) (f : ℕ → ℕ) : c * pk n f = pk n (fun j => c * f j) := by
  simp [pk, Finset.mul_sum, Nat.mul_assoc]

lemma pk_congr {n : ℕ} {f g : ℕ → ℕ} (h : ∀ j < n, f j = g j) : pk n f = pk n g :=
  Finset.sum_congr rfl fun j hj => by rw [h j (by simpa using hj)]

lemma pk_bit {n : ℕ} {f : ℕ → ℕ} (h : ∀ j < n, f j < 16777216)
    {r b : ℕ} (hr : r < n) (hb : b < 24) :
    (pk n f).testBit (24 * r + b) = (f r).testBit b := by
  induction n with
  | zero => omega
  | succ n ih =>
    have h1 := pk_lt (fun j hj => h j (Nat.lt_trans hj (Nat.lt_succ_self n)))
    rw [pk_succ, Nat.testBit_two_pow_mul_add _ h1]
    by_cases hr' : r < n
    · rw [ite_eq_left (by omega)]; exact ih (fun j hj => h j (by omega)) hr'
    · have e : r = n := by omega
      subst r
      rw [ite_eq_right (by omega), show 24 * n + b - 24 * n = b by omega]

def ones : ℕ := (2 ^ (24 * slots) - 1) / (2^24 - 1)

lemma rep_eq (n : ℕ) : pk n (fun _ => 1) * (2^24-1) + 1 = 2^(24*n) := by
  induction n with
  | zero => simp [pk]
  | succ n ih =>
    rw [pk_succ, show 24 * (n+1) = 24*n+24 by omega, pow_add]
    change (2 ^ (24*n) * 1 + pk n (fun _ => 1)) * 16777215 + 1 = 2 ^ (24*n) * 16777216
    change pk n (fun _ => 1) * 16777215 + 1 = 2^(24*n) at ih
    calc
      _ = (pk n (fun _ => 1) * 16777215 + 1) + 2^(24*n)*16777215 := by ring
      _ = _ := by rw [ih]; ring

lemma ones_eq : ones = pk slots (fun _ => 1) := by
  unfold ones
  have h := rep_eq slots
  rw [← h]
  simp

def denseFlag (x r : ℕ) := (x.testBit (24*r)).toNat

lemma pk_eq_of_mask {n x : ℕ} (h : x &&& pk n (fun _ => 1) = x) :
    x = pk n (denseFlag x) := by
  induction n generalizing x with
  | zero => simpa [pk] using h.symm
  | succ n ih =>
    let z := 2^(24*n)
    have hz : 0 < z := pow_pos (by decide) _
    have hh := pk_lt (n := n) (f := fun _ => 1) (by intros; decide)
    have hx : ∀ i, x.testBit i = true → (pk (n+1) (fun _ => 1)).testBit i = true := by
      intro i hi
      have he := congrArg (fun v : ℕ => v.testBit i) h
      simpa [hi] using he
    have hl : x % z &&& pk n (fun _ => 1) = x % z := by
      apply Nat.eq_of_testBit_eq; intro i
      simp only [Nat.testBit_and, Nat.testBit_mod_two_pow, z]
      by_cases hi : i < 24*n
      · simp [hi]
        intro hhx
        have hm := hx i hhx
        rw [pk_succ, Nat.testBit_two_pow_mul_add _ hh, ite_eq_left hi] at hm
        exact hm
      · simp [hi]
    have hd : x / z = denseFlag x n := by
      apply Nat.eq_of_testBit_eq; intro i
      rw [show z = 2^(24*n) from rfl, Nat.testBit_div_two_pow]
      cases i with
      | zero => cases he : x.testBit (24*n) <;> simp [denseFlag, he]
      | succ i =>
        have h0 : x.testBit (i+1+24*n) = false := by
          by_contra hc
          have h2 := hx _ (by simpa using hc)
          rw [pk_succ, Nat.testBit_two_pow_mul_add _ hh, ite_eq_right (by omega),
            show i+1+24*n-24*n = i+1 by omega] at h2
          simp [Nat.testBit_succ] at h2
        rw [h0]
        cases he : x.testBit (24*n) <;> simp [denseFlag, he, Nat.testBit_succ]
    have he : x % z = pk n (denseFlag x) := by
      rw [ih hl]
      apply pk_congr; intro j hj
      simp [denseFlag, z, Nat.testBit_mod_two_pow, show 24*j < 24*n by omega]
    rw [pk_succ, ← hd, ← he]
    exact (Nat.div_add_mod x z).symm

def geMask (v t : ℕ) := v + (guardValue - t) * ones

lemma geMask_bit {v t r : ℕ} {g : ℕ → ℕ} (hv : v = pk slots g)
    (hr : r < slots) (hg : ∀ j < slots, g j < guardValue) (ht : t ≤ guardValue) :
    (geMask v t).testBit (24*r+23) = decide (t ≤ g r) := by
  unfold guardValue at ht hg
  rw [geMask, hv, ones_eq, pk_smul, pk_add, pk_bit (by intro j hj; specialize hg j hj; simp [guardValue]; omega) hr (by decide)]
  have h := hg r hr
  simp only [Nat.mul_one, guardValue, Nat.testBit, Nat.shiftRight_eq_div_pow, Nat.one_and_eq_mod_two]
  apply Bool.eq_iff_iff.mpr
  simp only [bne_iff_ne, decide_eq_true_eq]
  change ((g r + (8388608-t)) / 8388608 % 2 ≠ 0) ↔ _
  omega

