def frequencyRow (c b : ℕ) :=
  let d := (distData >>> (3*(c%2233))) &&& 7
  (freqData >>> (64*(7*b+d))) &&& 18446744073709551615
def edge (tab j : ℕ) := (tab >>> (8*j)) &&& 255
def symbol (tab z : ℕ) :=
  if z < edge tab 3 then
    if z < edge tab 1 then (if z < edge tab 0 then 0 else 1)
    else (if z < edge tab 2 then 2 else 3)
  else if z < edge tab 5 then (if z < edge tab 4 then 4 else 5)
  else if z < edge tab 7 then (if z < edge tab 6 then 6 else 7) else 8
def decode (c b n : ℕ) : ℕ × ℕ :=
  let tab := frequencyRow c b
  let z := n &&& 255
  let s := symbol tab z
  let lo := if s=0 then 0 else edge tab (s-1)
  let hi := if s=8 then 256 else edge tab s
  let u := (n >>> 8)*(hi-lo) + (z-lo)
  let k := b-3
  if s=0 then (0,u) else (1 + ((s-1) <<< k) + (u &&& (2^k-1)), u >>> k)

-- A cover must collect at least the total weight assigned to the cells it covers.
-- If every allowed rectangle gains at most m, one of gain g can occur in a cover
-- of at most k rectangles only when the total weight is at most g + (k-1)m.
abbrev Weights := List (ℕ × ℕ)
def tally : Weights → ℕ × ℕ
  | [] => (0, 0)
  | (c,w)::ws => let u := tally ws; (w + u.1, w*c + u.2)

def gain : Weights → ℕ → ℕ
  | [], _ => 0
  | (c,w)::ws, r => (if c.testBit (24*r) then w else 0) + gain ws r

def Clean (cs : List ℕ) := ∀ c ∈ cs, c &&& ones = c
def Covers (cs L : List ℕ) := ∀ c ∈ cs, ∃ r ∈ L, c.testBit (24*r) = true
def Allowed (a r : ℕ) := r < slots ∧ a.testBit (24*r+23) = true
def Possible (cs : List ℕ) (a k : ℕ) := ∃ L : List ℕ, L.length ≤ k ∧ (∀ r ∈ L, Allowed a r) ∧ Covers cs L

def score (f : ℕ → ℕ) : List ℕ → ℕ
  | [] => 0
  | r::rs => f r + score f rs

lemma score_add (f g : ℕ → ℕ) (L : List ℕ) :
    score (fun j => f j + g j) L = score f L + score g L := by
  induction L with
  | nil => rfl
  | cons r rs ih => simp only [score, ih]; omega

lemma score_member (f : ℕ → ℕ) {L : List ℕ} {r : ℕ} (hr : r ∈ L) : f r ≤ score f L := by
  induction L with
  | nil => simp at hr
  | cons a as ih =>
    rw [score]
    rcases List.mem_cons.mp hr with h|h
    · subst a; omega
    · have := ih h; omega

lemma score_le {f : ℕ → ℕ} {L : List ℕ} {m : ℕ} (hm : ∀ r ∈ L, f r ≤ m) :
    score f L ≤ L.length*m := by
  induction L with
  | nil => simp [score]
  | cons a as ih =>
    have h1 := hm a (by simp)
    have h2 := ih (fun r h => hm r (by simp [h]))
    simp only [score, List.length_cons, Nat.succ_mul]; omega

lemma score_erase (f : ℕ → ℕ) {L : List ℕ} {r : ℕ} (hr : r ∈ L) :
    score f L = f r + score f (L.erase r) := by
  induction L with
  | nil => simp at hr
  | cons a as ih =>
    by_cases h : a = r
    · subst a; simp [score]
    · have hr' : r ∈ as := List.mem_of_ne_of_mem (Ne.symm h) hr
      simp [List.erase_cons_tail, h, score, ih hr', Nat.add_left_comm]

lemma gain_le (ws : Weights) (r : ℕ) : gain ws r ≤ (tally ws).1 := by
  induction ws with
  | nil => rfl
  | cons p ws ih => rcases p with ⟨c,w⟩; simp only [gain,tally]; split <;> omega

lemma tally_pk {ws : Weights} (hs : ∀ p ∈ ws, p.1 &&& ones = p.1) :
    (tally ws).2 = pk slots (gain ws) := by
  induction ws with
  | nil => simp [tally, pk, gain]
  | cons p ws ih =>
    obtain ⟨c,w⟩ := p
    have hc := hs (c,w) (by simp)
    dsimp only at hc
    rw [ones_eq] at hc
    have eh := pk_eq_of_mask hc
    simp only [tally]
    conv_lhs => arg 1; rhs; rw [eh]
    rw [ih (fun p hp => hs p (by simp [hp])), pk_smul, pk_add]
    apply pk_congr; intro j hj
    cases hh : c.testBit (24*j) <;> simp [gain, denseFlag, hh]

lemma tally_le_score {ws : Weights} {L : List ℕ}
    (hit : ∀ p ∈ ws, ∃ r ∈ L, p.1.testBit (24*r) = true) :
    (tally ws).1 ≤ score (gain ws) L := by
  induction ws with
  | nil =>
    change 0 ≤ _; omega
  | cons p ws ih =>
    obtain ⟨c,w⟩ := p
    obtain ⟨r, hr, hh⟩ := hit (c,w) (by simp)
    have h1 := score_member (fun j => if c.testBit (24*j) then w else 0) hr
    dsimp only at hh
    simp only [hh, ite_true] at h1
    have h2 := ih (fun p hp => hit p (by simp [hp]))
    change w + (tally ws).1 ≤ score (fun j => (if c.testBit (24*j) then w else 0) + gain ws j) L
    rw [score_add]; omega

def readWeights (width : ℕ) : List ℕ → ℕ → Weights
  | [], _ => []
  | c::cs, d =>
    let v := decode c width d
    if v.1 = 0 then readWeights width cs v.2
    else (c,v.1) :: readWeights width cs v.2

lemma read_mem {b n : ℕ} {cs : List ℕ} {p : ℕ × ℕ} (h : p ∈ readWeights b cs n) : p.1 ∈ cs := by
  induction cs generalizing n with
  | nil => simp [readWeights] at h
  | cons c cs ih =>
    simp only [readWeights] at h
    split at h
    · exact List.mem_cons_of_mem _ (ih h)
    · rcases List.mem_cons.mp h with e|e
      · subst p; simp
      · exact List.mem_cons_of_mem _ (ih e)

def validCap (u : ℕ × ℕ) (a m : ℕ) : Bool :=
  decide (u.1 < guardValue) && decide (m < guardValue) && ((geMask u.2 (m+1) &&& a) == 0)

lemma capped {ws : Weights} {a m : ℕ} (hs : ∀ p ∈ ws, p.1 &&& ones = p.1)
    (hc : validCap (tally ws) a m = true) {r : ℕ} (hr : Allowed a r) : gain ws r ≤ m := by
  simp only [validCap, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at hc
  obtain ⟨⟨hguard, hm⟩, he⟩ := hc
  have eq := congrArg (fun x : ℕ => x.testBit (24*r+23)) he
  rw [Nat.testBit_and, hr.2, Bool.and_true, geMask_bit (tally_pk hs) hr.1
    (fun j _ => lt_of_le_of_lt (gain_le ws j) hguard) (by omega)] at eq
  simp at eq; omega

lemma threshold {ws : Weights} {cs L : List ℕ} {a k m : ℕ}
    (inc : ∀ p ∈ ws, p.1 ∈ cs) (clean : Clean cs) (cov : Covers cs L)
    (len : L.length ≤ k) (al : ∀ r ∈ L, Allowed a r) (hc : validCap (tally ws) a m = true) :
    (tally ws).1 ≤ k*m ∧ ∀ r ∈ L, Allowed (a &&& geMask (tally ws).2 ((tally ws).1 - (k-1)*m)) r := by
  have hw := fun p hp => clean p.1 (inc p hp)
  have bound := fun r hr => capped hw hc (al r hr)
  have hsum := tally_le_score (fun p hp => cov p.1 (inc p hp))
  have hg : (tally ws).1 < guardValue := by
    simp only [validCap, Bool.and_eq_true, decide_eq_true_eq] at hc
    exact hc.1.1
  constructor
  · exact hsum.trans ((score_le bound).trans (Nat.mul_le_mul_right m len))
  · intro r hr
    have ha := al r hr
    refine ⟨ha.1, ?_⟩
    rw [Nat.testBit_and, ha.2, Bool.true_and, geMask_bit (tally_pk hw) ha.1
      (fun j _ => lt_of_le_of_lt (gain_le ws j) hg) (by omega)]
    apply decide_eq_true
    have hlen : (L.erase r).length ≤ k-1 := by rw [List.length_erase_of_mem hr]; omega
    have he := score_le (L := L.erase r) (fun j hj => bound j (List.mem_of_mem_erase hj))
    have he2 := he.trans (Nat.mul_le_mul_right m hlen)
    rw [score_erase (gain ws) hr] at hsum
    omega

-- Branch on including one rectangle, then check both possibilities. A weight
-- above k times the largest allowed gain closes the current branch.
abbrev Frame := List ℕ × ℕ × ℕ
def live (s : Frame) := Possible s.1 s.2.1 s.2.2
def after (cs : List ℕ) (r : ℕ) := cs.filter (fun c => !(c.testBit (24*r)))
def dropSlot (a r : ℕ) := a ^^^ (a &&& 2^(24*r+23))

lemma clean_after {cs : List ℕ} (h : Clean cs) (r : ℕ) : Clean (after cs r) :=
  fun c hc => h c (List.mem_filter.mp hc).1

lemma possible_take {cs L : List ℕ} {a k r : ℕ} (h : r ∈ L)
    (hlen : L.length ≤ k) (ha : ∀ j ∈ L, Allowed a j) (hc : Covers cs L) :
    Possible (after cs r) a (k-1) := by
  refine ⟨L.erase r, ?_, fun j hj => ha j (List.mem_of_mem_erase hj), ?_⟩
  · rw [List.length_erase_of_mem h]; omega
  · intro c hm
    obtain ⟨he, hz⟩ := List.mem_filter.mp hm
    obtain ⟨j, hj, hit⟩ := hc c he
    have hn : j ≠ r := by rintro rfl; simp [hit] at hz
    exact ⟨j, (List.mem_erase_of_ne hn).2 hj, hit⟩

lemma possible_split {cs : List ℕ} {a k : ℕ} (r : ℕ) (hp : Possible cs a k) :
    Possible (after cs r) a (k-1) ∨ Possible cs (dropSlot a r) k := by
  obtain ⟨L, len, al, cov⟩ := hp
  by_cases h : r ∈ L
  · exact Or.inl (possible_take h len al cov)
  · refine Or.inr ⟨L, len, ?_, cov⟩
    intro j hj
    obtain ⟨hb, he⟩ := al j hj
    have hn : r ≠ j := fun e => h (e ▸ hj)
    exact ⟨hb, by simp [dropSlot, Nat.testBit_xor, Nat.testBit_and, he, hn]⟩

def step (inst : ℕ) (s : Frame) (tail : List Frame) : Option (List Frame) :=
  let cs := s.1
  let a := s.2.1
  let k := s.2.2
  let v := inst >>> 1
  if (inst &&& 1) == 0 then
    some ((after cs v, a, k-1) :: (cs, dropSlot a v, k) :: tail)
  else
    let m := v &&& 4194303
    let ws := readWeights ((v >>> 22) &&& 31) cs (v >>> 27)
    let u := tally ws
    if validCap u a m then
      if k*m < u.1 then some tail
      else some ((cs, a &&& geMask u.2 (u.1 - (k-1)*m), k) :: tail)
    else none

def run : List ℕ → List Frame → Bool
  | [], stack => stack.isEmpty
  | _::_, [] => false
  | inst::rest, s::tail => match step inst s tail with
    | none => false
    | some stack => run rest stack

def AllClean (ss : List Frame) := ∀ s ∈ ss, Clean s.1
def AnyLive (ss : List Frame) := ∃ s ∈ ss, live s

lemma step_clean {inst : ℕ} {s : Frame} {ss out : List Frame}
    (hc : AllClean (s::ss)) (e : step inst s ss = some out) : AllClean out := by
  obtain ⟨cs,a,k⟩ := s
  have h0 : Clean cs := hc (cs,a,k) List.mem_cons_self
  have ht : AllClean ss := fun t ht => hc t (by simp [ht])
  simp only [step] at e
  split at e
  · cases e
    intro v hv
    rcases List.mem_cons.mp hv with rfl|hv
    · exact clean_after h0 _
    rcases List.mem_cons.mp hv with rfl|hv
    · exact h0
    · exact ht v hv
  · split at e
    · split at e
      · cases e; exact ht
      · cases e; intro v hv; rcases List.mem_cons.mp hv with rfl|hv
        · exact h0
        · exact ht v hv
    · contradiction

lemma step_live {inst : ℕ} {s : Frame} {ss out : List Frame}
    (hc : Clean s.1) (hl : AnyLive (s::ss)) (e : step inst s ss = some out) : AnyLive out := by
  obtain ⟨cs,a,k⟩ := s
  obtain ⟨v, hv, hp⟩ := hl
  simp only [step] at e
  split at e
  · cases e
    rcases List.mem_cons.mp hv with rfl|hv
    · obtain h|h := possible_split (inst >>> 1) hp
      · exact ⟨_, List.mem_cons_self, h⟩
      · exact ⟨_, List.mem_cons_of_mem _ List.mem_cons_self, h⟩
    · exact ⟨v, List.mem_cons_of_mem _ (List.mem_cons_of_mem _ hv), hp⟩
  · split at e
    next hcap =>
      split at e
      next hclose =>
        cases e
        rcases List.mem_cons.mp hv with rfl|hv
        · obtain ⟨L, len, al, cov⟩ := hp
          have h := (threshold (fun _ h => read_mem h) hc cov len al hcap).1
          exact False.elim ((Nat.not_lt_of_ge h) hclose)
        · exact ⟨v, hv, hp⟩
      next =>
        cases e
        rcases List.mem_cons.mp hv with rfl|hv
        · obtain ⟨L,len,al,cov⟩ := hp
          have h := (threshold (fun _ h => read_mem h) hc cov len al hcap).2
          exact ⟨_, List.mem_cons_self, L, len, h, cov⟩
        · exact ⟨v, List.mem_cons_of_mem _ hv, hp⟩
    next => contradiction

lemma run_sound {program : List ℕ} {stack : List Frame} (h : run program stack = true)
    (hc : AllClean stack) : ¬ AnyLive stack := by
  induction program generalizing stack with
  | nil =>
    simp only [run, List.isEmpty_iff] at h
    subst stack; simp [AnyLive]
  | cons inst rest ih =>
    cases stack with
    | nil => simp [AnyLive]
    | cons s ss =>
      simp only [run] at h
      split at h
      next => contradiction
      next out he =>
        intro hl
        exact ih h (step_clean hc he) (step_live (hc s (by simp)) hl he)

lemma noFrame {program : List ℕ} {cs : List ℕ} {a k : ℕ} (hc : Clean cs)
    (h : run program [(cs,a,k)] = true) : ¬ Possible cs a k := by
  intro hp
  apply run_sound h (by intro v hv; simp at hv; subst v; exact hc)
  exact ⟨_, List.mem_cons_self, hp⟩

