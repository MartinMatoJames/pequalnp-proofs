lemma impossible {L : List Box} (hlen : L.length ≤ 9)
    (sound : ∀ b ∈ L, ∀ i ∈ b.1, ∀ j ∈ b.2, forbidden i j = false)
    (cover : ∀ i j : V, forbidden i j = false → ∃ b ∈ L, i ∈ b.1 ∧ j ∈ b.2) : False := by
  have hb : Bounded (L.map label) := by
    intro r hr
    obtain ⟨b,_,rfl⟩ := List.mem_map.mp hr
    exact label_bound b
  have hg : Geo (L.map label) := by
    intro i j hz
    obtain ⟨b,hm,hi,hj⟩ := cover i j hz
    exact ⟨label b,List.mem_map_of_mem hm,label_hit hi hj (sound b hm)⟩
  obtain ⟨r,hr,h⟩ := root_witness (by simpa only [List.length_map] using hlen) hb hg
  exact no_root hr h

